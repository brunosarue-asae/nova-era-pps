{
  "version": 2,
  "name": "nova-era-pps",
  "builds": [
    {"src": "*.html", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/obrigado", "dest": "/obrigado.html"},
    {"src": "/aguardando-pagamento", "dest": "/aguardando-pagamento.html"},
    {"src": "/aguardando-analise", "dest": "/aguardando-analise.html"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
